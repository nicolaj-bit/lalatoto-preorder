{
  "name": "Påmindelse før forfald",
  "description": "Kalder remindUpcomingPreorders hver dag kl. 8 dansk tid. Admin får en mail om de forudbestillinger, der forfalder om 7 dage.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Europe/Copenhagen",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "paamindelse_foer_forfald",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "remindUpcomingPreorders",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
